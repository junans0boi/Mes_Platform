# 복사해서 .env.local로 사용한다. .env.local은 커밋하지 않는다.

# 백엔드 API / SignalR Hub 주소 (비워 두면 같은 origin을 사용)
VITE_API_BASE_URL=
VITE_HUB_URL=

# 개발 서버 proxy 대상 (예: http://localhost:5080). 설정하면 /api, /hubs를 이 주소로 전달한다.
VITE_DEV_PROXY_TARGET=

# MUI X DataGrid Premium 라이선스 키 (클라이언트 키이며 번들에 포함된다). 값은 .env.local에만 둔다.
VITE_MUIX_LICENSE_KEY=
