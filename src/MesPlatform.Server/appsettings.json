{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Database": {
    "DefaultCommandTimeoutSeconds": 30,
    "LongCommandTimeoutSeconds": 120,
    "ApplicationName": "MesPlatform"
  }
}
